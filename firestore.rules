rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The one account that is always treated as manager, so there is a way
    // to approve the very first real manager. Change this to your own email.
    function isBootstrapManager() {
      return request.auth.token.email.lower() == 'idobi.renboim.ido@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isManager() {
      return isSignedIn() && (
        isBootstrapManager() ||
        (myUserDoc().data.role == 'manager' && myUserDoc().data.status == 'approved')
      );
    }

    function isApproved() {
      return isSignedIn() && (
        isBootstrapManager() ||
        myUserDoc().data.status == 'approved'
      );
    }

    match /users/{uid} {
      // Approved coworkers may see fixed-schedule employees, so everyone can
      // see who works each day while filling in their own availability.
      allow read: if isSignedIn() && (request.auth.uid == uid || isManager() || (
        isApproved() &&
        resource.data.isFixedSchedule == true &&
        resource.data.status == 'approved'
      ));

      // First login: a user may create only their own doc, and only as a
      // pending employee — never self-assign manager/approved.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'employee'
        && request.resource.data.status == 'pending';

      // Managers can change role/status/etc (approve, reject, promote, mark fixed-schedule).
      // A fixed-schedule employee may additionally edit only their own fixedDays field.
      allow update: if isManager() || (
        isSignedIn() && request.auth.uid == uid &&
        resource.data.status == 'approved' &&
        resource.data.isFixedSchedule == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fixedDays'])
      );
    }

    // Fixed employees without an app account, managed by managers. Approved
    // employees can read them so they show up in "who works each day".
    match /staff/{staffId} {
      allow read: if isApproved();
      allow write: if isManager();
    }

    match /settings/{docId} {
      allow read: if isApproved();
      allow write: if isManager();
    }

    match /weeks/{weekId} {
      allow read: if isApproved();
      allow write: if isManager();

      match /availability/{uid} {
        // Every approved employee sees everyone's availability (who works which day).
        allow read: if isApproved();
        allow write: if isApproved() && request.auth.uid == uid;
      }
    }
  }
}
